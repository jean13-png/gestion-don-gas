generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Donateur {
  id         String   @id @default(cuid())
  nom        String
  prenom     String
  organisme  String?
  email      String
  telephone  String
  createdAt  DateTime @default(now())
  dons       Don[]
}

model Don {
  id                String      @id @default(cuid())
  reference         String      @unique
  nature            NatureDon
  natureAutre       String?
  description       String
  localisation      String
  pays              String?
  ville             String?
  quartierVillage   String?
  objectif          ObjectifDon @default(AUTRES)
  objectifAutre     String?
  responsable       String @default("HEDJE ZINSOU RAOUL")
  faitA             String?
  dateReception     DateTime? @default(now())
  statut            StatutDon   @default(SOUMIS)
  dateProgrammation DateTime?
  donateur          Donateur    @relation(fields: [donateurId], references: [id])
  donateurId        String
  photos            Photo[]
  messages          DonMessage[]
  observations      String?
  ficheUrl          String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  validatedAt       DateTime?
}

model DonMessage {
  id        String   @id @default(cuid())
  don       Don      @relation(fields: [donId], references: [id], onDelete: Cascade)
  donId     String
  expediteur String
  contenu   String
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  don       Don      @relation(fields: [donId], references: [id], onDelete: Cascade)
  donId     String
  createdAt DateTime @default(now())
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nom          String
  createdAt    DateTime @default(now())
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

model Partenaire {
  id               String   @id @default(cuid())
  nom              String
  logoUrl          String
  siteWeb          String?
  consentementLogo Boolean
  ordre            Int      @default(0)
  visible          Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@map("partenaires")
}

model Parametre {
  cle    String @id
  valeur String
}

model Historique {
  id           String   @id @default(cuid())
  type         String
  donId        String?
  destinataire String?
  sujet        String?
  contenuHtml  String?
  statut       String
  erreur       String?
  message      String?
  createdAt    DateTime @default(now())
}

enum NatureDon {
  MATERIEL_INFORMATIQUE
  EQUIPEMENT_PEDAGOGIQUE
  DON_FINANCIER
  DES_HABITS
  DES_VIVRES
  MACHINES_A_COUDRE
  VEHICULES
  BUS_TRANSPORT
  ORDINATEURS
  MOBILIER
  JOUETS
  LIVRES
  FAUTEUILS_MEDICAUX
  BEQUILLES
  APPARTEMENT
  MAISON
  MATELAS
  IMPRIMANTES
  AUTRE
}

enum StatutDon {
  SOUMIS
  EN_VERIFICATION
  INSPECTE
  VALIDE
  FICHE_GENEREE
  PROGRAMMEE
  REJETE
}

enum ObjectifDon {
  EDUCATION
  AIDE_SOCIALE
  FORMATION
  AUTRES
}
